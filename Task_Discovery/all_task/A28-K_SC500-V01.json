            },
            "ExtFlow": {
                "type": "Device",
                "category": "Sensor",
                "measuresProperty": "Air-Flow-Extraction",
                "unit": "MQH"
            },
            "SupFlow": {
                "type": "Device",
                "category": "Sensor",
                "measuresProperty": "Air-Flow-Supply",
                "unit": "MQH"
            }
        },
        "arguments": {
            "scope": {
                "type": "enum",
                "values": [
                    "1 minute",
                    "5 minutes",
                    "15 minutes",
                    "hourly",
                    "daily",
                    "weekly",
                    "yearly"
                ]
            }
        },
        "taskId": "A28-K:SC500-V01",
        "name": "Specific Electricity Use"
    }
